{
    "name": "kode/fibers",
    "description": "Kode/Fibers - 高性能 PHP Fiber 协程调度器。提供协程池、上下文传递、分布式调度、断路器、负载均衡、RPC 通信（JSON/gRPC/WebSocket）、分布式事务（2PC/TCC/Saga）、多框架集成等企业级特性。",
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.5.0",
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/psr7": "^2.8",
        "kode/context": "^3.0",
        "kode/console": "^4.0"
    },
    "require-dev": {
        "amphp/amp": "^3.0",
        "amphp/pipeline": "^1.2",
        "phpunit/phpunit": "^12.5",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2",
        "revolt/event-loop": "^1.0"
    },
    "suggest": {
        "kode/facade": "可选；未安装时自动降级为基础静态代理（native driver）",
        "kode/http-client": "可选；未安装时自动降级为内置 HTTP 驱动",
        "ext-curl": "用于 HTTP 客户端 cURL 驱动",
        "ext-swoole": "用于 Swoole 协程支持",
        "ext-swow": "用于 Swow 协程支持"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Fibers\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Fibers\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fibers"
    ],
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "test-coverage": "php vendor/bin/phpunit --coverage-html coverage",
        "bench": "php benchmarks/bench.php"
    },
    "config": {
        "sort-packages": true
    }
}
